pico-8 cartridge // http://www.pico-8.com
version 38
__lua__

function _init()
	init_map()
end

function _update()
	if btnp(⬅️) then act(⬅️) elseif btnp(➡️) then act(➡️) elseif btnp(⬆️) then act(⬆️) elseif btnp(⬇️) then act(⬇️) end
end

function def_ai(a)
	a.t += a.speed
end

function remove_blocked(moves)
	local result = {}
	for m in all(moves) do
		if not fget(mget(m[1],m[2]), 1) then
			add(result, m)
		end
	end
	return result
end

function zombie_ai(a)
	local nx,ny = a.x,a,y
	local moves = {}
	if a.x>pc.x then add(moves,{a.x-1,a.y}) end
	if a.x<pc.x then add(moves,{a.x+1,a.y}) end
	if a.y>pc.y then add(moves,{a.x,a.y-1}) end
	if a.y<pc.y then add(moves,{a.x,a.y+1}) end
	moves = remove_blocked(moves)	
	if #moves == 0 then
		add(moves,{a.x-1,a.y})	
		add(moves,{a.x+1,a.y})	
		add(moves,{a.x,a.y-1})	
		add(moves,{a.x,a.y+1})	
		moves = remove_blocked(moves)	
	end
	if #moves > 0 then
		local m = rnd(moves)
		move_abs(a, unpack(m))
	else
		a.t += a.spd
	end
end

function zombie()
	return {
		x=5,y=5,ai=zombie_ai,spd=20,t=10,spr=49
	}
end

function init_map()
	add(actors, zombie())
end

function act(btn)
	-- it's pcs turn - act
	move(pc, btn)
	-- and have the other actors act until it's pcs turn again
	while pc.t > 0 do
		for a in all(actors) do
			if a.t <= 0 then
				if a == pc then break end
				if a.ai != nil then a:ai() else def_ai(a) end
			else a.t -= 1 end
		end
	end
end

function move(actor, dir)
	local nx = actor.x
	local ny = actor.y
	if btnp(⬅️) then nx -= 1 elseif btnp(➡️) then nx+=1 elseif btnp(⬆️) then ny-=1 elseif btnp(⬇️) then ny+=1 end
	move_abs(actor, nx, ny)
end

function move_abs(actor, nx, ny)
	if not fget(mget(nx,ny),0) then
		actor.x = nx
		actor.y = ny
	end
	actor.t += actor.s or DEF_SP
end

pc = {x=8,y=8,spr=48,ai=nil,spd=10,t=0}
actors = {pc}
MWIDTH=32
MHEIGHT=32
DEF_SP=10

function _draw()
	cls()
	palt(0, false)
	palt(14, true)
	camera(min(MWIDTH*8-128, max(0,pc.x*8-64)), min(MHEIGHT*8-64,max(0,pc.y*8-128)))
	map()
	for a in all(actors) do
		spr(a.spr, a.x*8,a.y*8)
	end
end

